# Copy this file to .env and edit as needed. Every variable here has a
# built-in fallback in config.py (the value currently shown), so .env
# is optional — it only overrides a default, nothing requires it to run.

# SEC EDGAR requires a real-looking User-Agent header on every request
# (see edgar_ingest.py / xbrl_facts.py) — SEC checks the email format.
SEC_USER_AGENT_NAME=Rid
SEC_USER_AGENT_EMAIL=riddhesh2307@gmail.com

# Local Ollama server (answer.py / agent.py / eval_harness.py).
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL_NAME=qwen2.5:7b-instruct

# Persistent Chroma vector store path — must match across
# index_chunks.py / retrieval.py / query_chunks.py, since they all have
# to agree on where the same index lives.
CHROMA_DIR=./chroma_db

# Embedding + reranking models, used at both index time and query time.
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
