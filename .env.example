# Copy this file to .env and edit as needed. Every variable here has a
# built-in fallback in config.py (the value currently shown), so .env
# is optional — it only overrides a default, nothing requires it to run.

# SEC EDGAR requires a real-looking User-Agent header on every request
# (see edgar_ingest.py / xbrl_facts.py) — SEC checks the email format.
SEC_USER_AGENT_NAME=Rid
SEC_USER_AGENT_EMAIL=riddhesh2307@gmail.com

# Which LLM backend agent.py/eval_harness.py use by default (see
# llm_backends.py's BACKENDS dict for the full list: gemini).
DEFAULT_BACKEND=gemini

# Gemini backend -- free tier via aistudio.google.com, no credit card
# required. Required: it's the only backend.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-lite-latest

# Persistent Chroma vector store path — must match across
# index_chunks.py / retrieval.py, since they both have to agree on
# where the same index lives. A relative path here (and in TRACE_LOG_PATH)
# resolves against the project root, not the working directory.
CHROMA_DIR=var/chroma_db

# Embedding + reranking models, used at both index time and query time.
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# mcp_server.py auth/rate limiting -- MCP_AUTH_TOKEN empty means auth is
# disabled (fine for local use; set it before exposing the server
# beyond localhost). Callers must then send `Authorization: Bearer
# <token>`. MCP_RATE_LIMIT_REQUESTS=0 disables rate limiting.
MCP_AUTH_TOKEN=
MCP_RATE_LIMIT_REQUESTS=60
MCP_RATE_LIMIT_WINDOW_SECONDS=60

# Langfuse tracing (tracing.py) -- empty keys mean tracing is disabled
# entirely (fine, this is fully optional). Sign up free at
# langfuse.com to get LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Local JSONL trace log -- always-on backup of the same spans/events
# sent to Langfuse, independent of whether Langfuse is configured.
# Empty string disables it (unlike the Langfuse settings above, this
# one is ON by default).
TRACE_LOG_PATH=var/trace_logs/traces.jsonl
